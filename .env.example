# All paths refer to the host. Relative paths resolve from the repository root.
AI_STATION_DATA_HOST_PATH=./data
AI_STATION_PORT=8765
# Staged private accounts; keep operator for the current release/live installation.
# Accounts is a one-way ownership cutover. See docs/accounts.md before opting in.
AI_STATION_ACCESS_PROFILE=operator
# Empty selects a private socket directory beneath the application data root.
AI_STATION_RUNNER_SOCKET=
# Host endpoint; the private runner bridge reaches loopback-only servers.
AI_STATION_LLM_BASE_URL=http://127.0.0.1:11434/v1
AI_STATION_LLM_TRANSPORT=runner
# Optional direct transport uses this container-reachable endpoint.
AI_STATION_LLM_CONTAINER_BASE_URL=http://host.docker.internal:8080/v1
AI_STATION_LLM_MODEL=
AI_STATION_LLM_API_KEY=
# Extra Chat providers store env:NAME or a write-only data-root secret; never put keys in URLs.
# Configure existing components; bootstrap never downloads models or drivers.
AI_STATION_PHOTO_PYTHON=
AI_STATION_PHOTO_SCRIPT=
AI_STATION_SD_CLI=
# Optional AI Station-owned Krea installation, separate from external ComfyUI.
# Leave disabled until GPU-only generation/edit/recompose qualification is complete.
AI_STATION_KREA_RUNTIME_DIR=
AI_STATION_KREA_COMPANIONS_DIR=
AI_STATION_KREA_ENABLED=false
# Colon-separated host roots. Leave empty until needed.
AI_STATION_MODEL_ROOTS=
AI_STATION_ALLOWED_ROOTS=
# Optional Skills root; defaults to <data>/skills. Instruction packs only.
AI_STATION_SKILLS_DIR=
AI_STATION_ENABLE_TEST_EXECUTOR=false
# Independent worker slots (1–8). GPU/worktree locks still limit heavy jobs.
AI_STATION_WORKER_SLOTS=3

# Optional existing Node distribution prefix (bin/node + lib/node_modules/npm).
# Used only by explicit owned-worktree npm installs and saved Node validation.
AI_STATION_NODE_PREFIX=

# Already-installed llama.cpp server image; Runner only, never auto-pulled.
AI_STATION_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda

# Existing Chatterbox clone_pl.py installation and populated Hugging Face cache.
# Offline only: AI Station does not download speech models.
AI_STATION_CHATTERBOX_PYTHON=
AI_STATION_CHATTERBOX_SCRIPT=
AI_STATION_CHATTERBOX_CACHE=
# Optional Fish S2 Pro expressive voice. Native runner only; disabled by default.
# Use an independently installed, pinned runtime and publisher-verified weights;
# see docs/plans/expressive-speech.md. Requires two BF16 CUDA GPUs (10/5 GiB
# free VRAM) and 24 GiB available RAM. No CPU weight offload or swap.
AI_STATION_FISH_SPEECH_ENABLED=false
AI_STATION_FISH_SPEECH_PYTHON=
AI_STATION_FISH_SPEECH_DIR=
AI_STATION_FISH_SPEECH_MODELS=
# Optional video-conditioned sound effects; native runner, disabled by default.
# Pinned standalone runtime + seven verified assets: docs/plans/synchronized-sound.md.
# Requires one BF16 CUDA GPU (8 GiB free VRAM) and 18 GiB available load RAM.
AI_STATION_MMAUDIO_ENABLED=false
AI_STATION_MMAUDIO_PYTHON=
AI_STATION_MMAUDIO_DIR=
AI_STATION_MMAUDIO_MODELS=
# Optional local music: a separate Python environment, pinned ACE-Step source,
# and explicitly installed checkpoints. See docs/plans/local-music-generation.md.
AI_STATION_MUSIC_PYTHON=
AI_STATION_MUSIC_SOURCE_DIR=
AI_STATION_MUSIC_MODEL_DIR=

# Optional existing EchoMimic V3 flash installation (never auto-downloaded).
AI_STATION_ECHOMIMIC_PYTHON=
AI_STATION_ECHOMIMIC_DIR=
AI_STATION_ECHOMIMIC_MODELS=
# Enable only after qualifying the existing Echo runtime under the fixed 11-GiB scope.
AI_STATION_ECHO_BOUNDED_PROFILE=false

# Optional whole-recording Sonic avatar profile. Keep disabled until this exact
# installation and the complete application workflow have been qualified.
# Installed source/weights remain native; no automatic model download.
AI_STATION_SONIC_PYTHON=
AI_STATION_SONIC_DIR=
AI_STATION_SONIC_MODELS=
AI_STATION_SONIC_WHOLE_ENABLED=false

# Optional Chat web search. Compose starts a private SearXNG service (no host port).
# Search is off until enabled for a message. Native development can use a configured endpoint.
AI_STATION_WEB_SEARCH_URL=http://search:8080

# Optional isolated public-page renderer; build explicitly, never auto-pulled.
AI_STATION_BROWSER_ENABLED=false
AI_STATION_BROWSER_IMAGE=ai-station-browser:local

# Optional offline Python workload image; explicit build, never auto-pulled.
AI_STATION_PYTHON_IMAGE=ai-station-python:local

# Optional local Wan 2.2 TI2V 5B; existing ComfyUI + safetensors only.
# ./scripts/bootstrap-video.sh /path/to/existing/ComfyUI creates project-only deps.
AI_STATION_VIDEO_PYTHON=
AI_STATION_COMFY_DIR=
AI_STATION_WAN_MODEL=
AI_STATION_WAN_TEXT_ENCODER=
AI_STATION_WAN_VAE=
# Optional fixed 11-GiB, zero-swap user scope. Keep disabled until this exact
# installed Wan runtime/profile is qualified; see docs/plans/wan-memory-profile.md.
AI_STATION_WAN_BOUNDED_PROFILE=false

# Optional offline Whisper CPU transcription (separate venv + checked local model).
# See docs/audio-transcription.md. Empty leaves the adapter unavailable.
AI_STATION_TRANSCRIPTION_PYTHON=
AI_STATION_TRANSCRIPTION_MODEL_DIR=

# Optional private LAN UI/API; set an operator password in Settings first.
# A specific RFC1918 or Tailscale IPv4 address only; never 0.0.0.0.
AI_STATION_LAN_HOST=
# Optional exact private proxy origins (comma separated), e.g. HTTPS tailnet DNS.
# This allowlist does not install Tailscale or start a proxy/public listener.
AI_STATION_ACCESS_ORIGINS=

# Optional AI Station-owned Tailscale runtime. Settings → Operator access provides
# explicit installation/sign-in/enable controls; no root/system service is used.
# Empty defaults: XDG_CACHE_HOME/ai-station/tailscale/tailscale-<version>-<arch>
# and XDG_STATE_HOME/ai-station/tailnet-<data-root-hash>. Native state MUST remain
# outside APP_DATA and all allowed/model roots; never mount it into Docker.
AI_STATION_TAILNET_BINARY_DIR=
AI_STATION_TAILNET_PRIVATE_DIR=

# Optional offline static-site preview (build the workload explicitly first).
# docker build -f preview-executor/Dockerfile -t ai-station-site-preview:local .
AI_STATION_SITE_PREVIEW_ENABLED=false
AI_STATION_SITE_PREVIEW_IMAGE=
